# Copy this file to .env and set local-only values. Never commit .env.
# Local Postgres (docker compose) passwords. Local development only.
# Host port for the local Postgres. Change it when 5432 is already in use,
# and set the same port in the connection strings below.
POSTGRES_PORT=
POSTGRES_SUPER_PASSWORD=
PLATFORM_DB_PASSWORD=
SCHEDULE_DB_PASSWORD=
# Connection strings used by the apps and the integration tests.
PLATFORM_DATABASE_URL=
# Tests run against this database instead (rebuilt from scratch by the
# tenant tests). init.sh creates it, owned by the platform role.
PLATFORM_TEST_DATABASE_URL=
SCHEDULE_DATABASE_URL=
# Port the platform server listens on.
PLATFORM_PORT=
# Login (platform auth). JWT_SECRET is REQUIRED and has no default: the
# platform refuses to start when it is unset. Set a long random value per
# environment and never commit it.
JWT_SECRET=
# Session token lifetime (jsonwebtoken format, e.g. 7d, 12h). Optional.
JWT_EXPIRES_IN=
# Password login rate limit (Issue #16): failed attempts allowed
# within the window before a 429. Optional; defaults are 10 failures
# per email address and 100 per source address per 900 seconds. The
# source allowance is larger on purpose: a school's teachers share
# one outward address.
LOGIN_RATE_LIMIT_MAX_FAILURES=
LOGIN_RATE_LIMIT_WINDOW_SECONDS=
LOGIN_RATE_LIMIT_IP_MAX_FAILURES=
# Behind a reverse proxy, set this (for example "loopback") so the
# platform reads the real source address from X-Forwarded-For.
# Without it, every request appears to come from the proxy itself.
TRUST_PROXY=
# Google OAuth (optional; password login works without these). Set both
# or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
