{
  "name": "@school-manage/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "pnpm run build:server && pnpm run build:client",
    "build:server": "esbuild src/index.ts src/setup/setupSchool.ts src/setup/setupPlatformAdmin.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@school-manage/calendar-types=../packages/calendar-types/src/index.ts --alias:@school-manage/platform-client=../packages/platform-client/src/index.ts --outdir=dist",
    "build:client": "node scripts/build-client.mjs",
    "start:prod": "node dist/index.js",
    "setup:school:prod": "node dist/setup/setupSchool.js",
    "setup:platform-admin:prod": "node dist/setup/setupPlatformAdmin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "setup:school": "tsx src/setup/setupSchool.ts",
    "setup:platform-admin": "tsx src/setup/setupPlatformAdmin.ts"
  },
  "dependencies": {
    "@school-manage/calendar-types": "workspace:*",
    "@school-manage/platform-client": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "google-auth-library": "^11.3.3",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.5",
    "esbuild": "0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
